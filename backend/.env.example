# Konfigurasi Lingkungan Backend GDSS Pemilihan Calon Presiden

# Pengaturan Database MySQL / MariaDB (XAMPP default port 3306, user root tanpa password)
DB_DSN=mysql:host=127.0.0.1;port=3306;dbname=gdss_pemilihan_presiden;charset=utf8mb4
DB_USER=root
DB_PASSWORD=

# Kunci Rahasia Aplikasi untuk Penandatanganan Token HMAC-SHA256 (Minimal 32 Karakter)
# WAJIB DIGANTI PADA LINGKUNGAN PRODUKSI!
APP_KEY=gdss_presidential_secret_key_academic_simulation_2026_super_secure_token

# Konfigurasi CORS (Cross-Origin Resource Sharing) untuk Frontend
# Masukkan origin yang diizinkan dipisahkan dengan tanda koma
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://127.0.0.1:5500,http://localhost:5500,http://127.0.0.1:8000
